__pycache__/
*.pyc
.venv/
.DS_Store

# Salidas: se regeneran con `menu-ia`
output/

# ⚠️ El contenido de un cliente NUNCA entra a este repo.
# Precios de compra, márgenes, ventas y fotografía son del restaurante.
# Ver el inventario de confidencialidad del repo del cliente.
cartas-privadas/

# Metadatos de build de setuptools — se regeneran al instalar
*.egg-info/

# Artefactos de render dentro de los ejemplos: se regeneran con `menu-ia menu`.
# Lo que sí se versiona es `muestra/`, elegido a mano para poder verlo sin
# instalar nada.
ejemplos/*/render/menu-completo*.html
ejemplos/*/render/spreads-activos*.json
ejemplos/*/render/tapas-final*.html
